{
  "schemaVersion": 1,
  "id": "defgodqe-meteor",
  "version": "${version}",
  "name": "defgodqe Meteor Addon",
  "description": "defgodqe's Meteor Client addon for Minecraft 1.21.11.",
  "authors": [
    "defgodqe"
  ],
  "contact": {
    "sources": "https://github.com/defgodqe-arch/meteor"
  },
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.example.addon.AddonTemplate"
    ]
  },
  "mixins": [
    "addon-template.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "250,204,21",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}
